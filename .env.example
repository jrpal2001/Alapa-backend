# Environment Configuration Example for Alapa Backend Microservices

NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Microservices URLs
AUTH_USER_SERVICE_URL=http://127.0.0.1:8001
CHAT_SERVICE_URL=http://127.0.0.1:8003
VIDEO_SERVICE_URL=http://127.0.0.1:8004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8005

# MongoDB Atlas Connection URIs
MONGO_URI_AUTH=mongodb+srv://<user>:<password>@cluster.mongodb.net/alapa_auth_user
MONGO_URI_CHAT=mongodb+srv://<user>:<password>@cluster.mongodb.net/alapa_chat
MONGO_URI_VIDEO=mongodb+srv://<user>:<password>@cluster.mongodb.net/alapa_video

# Firebase Admin SDK Credentials (Kept secure in .env - Never commit live secrets)
FIREBASE_PROJECT_ID=alapa-32194
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@alapa-32194.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# WebRTC STUN / TURN Configuration
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:alapa.app:3478
TURN_USERNAME=alapastun
TURN_CREDENTIAL=AlapaTurnSecret2026!
